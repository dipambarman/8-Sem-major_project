generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserType {
  REGULAR
  PREMIUM
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  RAZORPAY
  SMARTPASS
}

enum PaymentType {
  ORDER_PAYMENT
  WALLET_TOPUP
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SmartPassStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SmartPassTier {
  SILVER
  GOLD
  PLATINUM
}

enum TransactionType {
  CREDIT
  DEBIT
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  passwordHash  String            
  fullName      String            
  phone         String            
  userType      UserType           @default(REGULAR)
  isActive      Boolean            @default(true)
  emailVerified Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  orders        Order[]
  reservations  Reservation[]
  wallet        Wallet?
  notifications Notification[]
  reviews       Review[]
  smartPass     SmartPass?
  payments      Payment[]

  @@map("users")
}

model Vendor {
  id             Int        @id @default(autoincrement())
  name           String    
  description    String?
  email          String     @unique
  phone          String?   
  password       String    
  address        String?
  operatingHours Json?
  cuisineType    Json?
  isActive       Boolean    @default(true)
  rating         Float      @default(0)
  licenseNumber  String?   
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  menuItems    MenuItem[]
  orders       Order[]
  reservations Reservation[]

  @@map("vendors")
}

model MenuItem {
  id              Int      @id @default(autoincrement())
  name            String  
  description     String?
  price           Float
  preparationTime Int      @default(15)
  category        String  
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isExpress       Boolean  @default(false)
  rating          Float    @default(0)
  vendorId        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  reviews    Review[]

  @@map("menu_items")
}

model Order {
  id                  Int           @id @default(autoincrement())
  orderNumber         String        @unique
  userId              Int
  vendorId            Int
  orderType           String        @default("pickup")
  status              OrderStatus   @default(PENDING)
  totalAmount         Float
  paymentMethod       String?      
  paymentStatus       PaymentStatus @default(PENDING)
  slotTime            DateTime?    
  specialInstructions String?
  qrCode              String?
  estimatedTime       Int?
  smartPassDiscount   Float         @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor   Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id                  Int    @id @default(autoincrement())
  orderId             Int
  menuItemId          Int
  quantity            Int
  price               Float
  specialInstructions String?

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id                  Int           @id @default(autoincrement())
  userId              Int
  orderId             Int?
  amount              Float
  paymentMethod       PaymentMethod @default(RAZORPAY)
  paymentType         PaymentType   @default(ORDER_PAYMENT)
  status              PaymentStatus @default(PENDING)
  razorpayOrderId     String?      
  razorpayPaymentId   String?      
  razorpaySignature   String?
  paymentTime         DateTime?    
  paymentResponse     Json?
  refundAmount        Float?
  refundTime          DateTime?    
  refundTransactionId String?      
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Float    @default(0.00)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  walletId    Int
  type        TransactionType
  amount      Float
  description String?        
  referenceId String?        
  createdAt   DateTime        @default(now())

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Reservation {
  id                  Int               @id @default(autoincrement())
  userId              Int
  vendorId            Int
  reservationTime     DateTime         
  partySize           Int
  diningArea          String            @default("main")
  status              ReservationStatus @default(PENDING)
  specialRequests     String?
  contactPhone        String?          
  tableNumber         Int?
  cancelReason        String?
  actualCheckInTime   DateTime?        
  actualCheckOutTime  DateTime?        
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String  
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  menuItemId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model SmartPass {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  tier            SmartPassTier   @default(SILVER)
  status          SmartPassStatus @default(PENDING)
  cardNumber      String?         @unique
  discountPercent Float           @default(5)
  activatedAt     DateTime?      
  expiresAt       DateTime?      
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smart_passes")
}
