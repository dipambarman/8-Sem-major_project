# ─── DATABASE ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (local or cloud)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/smart_canteen"

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate a strong secret key for production
JWT_SECRET="your_jwt_secret_key_here_change_in_production"

# ─── SERVER ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── RAZORPAY ────────────────────────────────────────────────────────────
# Get these from Razorpay dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ─── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── FRONTEND URL ──────────────────────────────────────────────────────────
# Update this with your actual frontend URL
FRONTEND_URL=https://your-frontend-url.com

# ─── SOCKET.IO ──────────────────────────────────────────────────────────────
# For production, use the backend URL
SOCKET_URL=https://your-backend-url.vercel.app
